<Window x:Class="AudioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioPlayer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="3*"/>
        </Grid.RowDefinitions>
        <Grid
            x:Name="TrackInfoGrid"
            Row="0" Column="0" ColumnSpan="2">
        </Grid>
        <Grid
            x:Name="TrackControlsGrid"
            Row="0" Column="2">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel 
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Center">
                <Button 
                    x:Name="rewindButton" 
                    Margin="2" 
                    Click="RewindButton_Click"
                    Background="Transparent"
                    BorderThickness="0">
                    <Image Source="/Image/rewind.png"
                            Width="28" Height="28">
                    </Image>
                </Button>

                <Button 
                    Name="PlayPauseButton" 
                    Margin="2" 
                    Click="PlayPauseButton_Click"
                    Background="Transparent"
                    BorderThickness="0">
                    <Image 
                        Name="PlayPauseImage" 
                        Source="/Image/play.png" 
                        Width="28"
                        Height="28" />
                </Button>

                <Button 
                    Name="forwardButton"
                    Margin="2"
                    Click="ForwardButton_Click"
                    Background="Transparent"
                    BorderThickness="0">
                    <Image 
                        Source="/Image/forward.png"
                        Width="28" Height="28" />
                </Button>
            </StackPanel>
            <Slider
                Grid.Row="1"
                Name="ProgressSlider"
                Style="{StaticResource CustomSliderStyle}"
                Minimum="0"
                Maximum="100"
                Value="0"
                Margin="10,5,10,5"
                VerticalAlignment="Center" />
            <Grid Grid.Row="2" Margin="10,5,10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel 
                    Grid.Column="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center">
                    <Image 
                        Source="/Image/volume.png" 
                        Width="20" Height="20" 
                        Margin="0,0,5,0"/>
                    <Slider 
                        x:Name="VolumeSlider" 
                        Style="{StaticResource VolumeSliderStyle}"
                        Minimum="0" Maximum="1" 
                        Value="0.5" 
                        Width="100" 
                        VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel 
                    Grid.Column="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center">
                    <Button Style="{StaticResource SpeedButtonStyle}" Content="0.5" Margin="3,0" Click="SpeedButton_Click"/>
                    <Button Style="{StaticResource SpeedButtonStyle}" Content="1" Margin="3,0" Click="SpeedButton_Click"/>
                    <Button Style="{StaticResource SpeedButtonStyle}" Content="2" Margin="3,0" Click="SpeedButton_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid
            x:Name="FoldersAccessGrid"
            Row="1" Column="0">
            <TreeView
                x:Name="FoldersTreeView"
                SelectedItemChanged="FoldersTreeView_OnSelectedItemChanged">
            </TreeView>
        </Grid>
        <Grid
            x:Name="TrackListGrid"
            Row="1" Column="1" ColumnSpan="2">
            <DataGrid
                x:Name="TrackDataGrid"
                CanUserResizeColumns="True"
                CanUserSortColumns="True"
                CanUserAddRows="False"
                IsReadOnly="True"
                CanUserDeleteRows="False"
                AutoGenerateColumns="False"
                ItemsSource="{Binding AudioFiles}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Исполнитель" Binding="{Binding Artist}" Width="*"/>
                    <DataGridTextColumn Header="Альбом" Binding="{Binding Album}" Width="*"/>
                    <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <GridSplitter
            Grid.Column="0"
            Grid.Row="1"
            Width="5"
            Background="Transparent"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Columns"/>
        <GridSplitter
            Grid.ColumnSpan="3"
            Grid.Column="0"
            Grid.Row="0"
            Height="5"
            Background="Transparent"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            ResizeBehavior="BasedOnAlignment"
            ResizeDirection="Rows"/>
    </Grid>
</Window>