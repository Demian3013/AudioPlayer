<Window x:Class="AudioPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AudioPlayer"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000"
        Background="{StaticResource MainBg}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1.7*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Border
            Grid.Row="0" 
            Grid.Column="0" 
            Grid.ColumnSpan="2"
            Style="{StaticResource GlassPanelStyle}">
            <Grid x:Name="TrackInfoGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image x:Name="TrackImage"
                       Source="Image/track_placeholder.png"
                       Height="100" Width="100"
                       Margin="10"
                       Stretch="UniformToFill"/>
                <StackPanel 
                    Grid.Column="1" 
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" 
                    Orientation="Horizontal">
                    <Label 
                        Content="Название:" 
                        VerticalAlignment="Center" 
                        Foreground="{StaticResource SecondaryText}"/>
                    <TextBlock 
                        x:Name="TrackNameTextBlock" 
                        VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel 
                    Grid.Column="1" 
                    Margin="0,25,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label 
                            Content="Автор:" 
                            VerticalAlignment="Center" 
                            Foreground="{StaticResource SecondaryText}"/>
                        <TextBlock 
                            x:Name="TrackArtistTextBlock" 
                            VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label 
                            Content="Год выхода:" 
                            VerticalAlignment="Center" 
                            Foreground="{StaticResource SecondaryText}"/>
                        <TextBlock 
                            x:Name="TrackYearTextBlock" 
                            VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label 
                            Content="Жанр:"
                            VerticalAlignment="Center" 
                            Foreground="{StaticResource SecondaryText}"/>
                        <TextBlock 
                            x:Name="TrackGenreTextBlock" 
                            VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel 
                    Grid.Column="2"
                    Margin="5,25,5,0">
                    <Label 
                        Content="Описание:"
                        VerticalAlignment="Center" 
                        Foreground="{StaticResource SecondaryText}"/>
                    <TextBlock 
                        x:Name="TrackDistributionTextBlock" 
                        TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border 
            Grid.Row="0" 
            Grid.Column="2" 
            Style="{StaticResource GlassPanelStyle}">
            <Grid x:Name="TrackControlsGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel 
                    Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,5,0,0">
                    <Button 
                        x:Name="RewindButton" 
                        Margin="0,0,15,0" 
                        Click="RewindButton_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand">
                        <Image 
                            Source="/Image/rewind.png" 
                            Width="28" Height="28"/>
                    </Button>
                    
                    <Button 
                        x:Name="PlayPauseButton" 
                        Margin="2" 
                        Click="PlayPauseButton_Click"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand">
                        <Image 
                            x:Name="PlayPauseImage" 
                            Source="/Image/play.png" 
                            Width="28" Height="28"/>
                    </Button>
                    
                    <Button 
                        x:Name="ForwardButton"
                        Margin="15,0,0,0" 
                        Click="ForwardButton_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand">
                        <Image 
                            Source="/Image/forward.png"
                            Width="28" Height="28"/>
                    </Button>
                </StackPanel>

                <Slider x:Name="ProgressSlider" 
                        Grid.Row="1"
                        Style="{StaticResource SliderStyle}"
                        Minimum="0" 
                        Maximum="1" 
                        Value="0"
                        SmallChange="0.01" 
                        Margin="10,5,10,5"
                        VerticalAlignment="Center"
                        PreviewMouseDown="ProgressSlider_PreviewMouseDown"
                        Cursor="Hand"/>

                <Grid Grid.Row="2"
                      Margin="10,5,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel 
                        Grid.Column="0"
                        Orientation="Horizontal" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Center">
                        <Image 
                            Source="/Image/volume.png"
                            Width="20" 
                            Height="20"
                            Margin="0,0,5,0" 
                            Cursor="Hand"/>
                        <Slider x:Name="VolumeSlider"
                                Style="{StaticResource SliderStyle}"
                                Minimum="0" 
                                Maximum="1" 
                                Value="0.5"
                                Width="100" 
                                LargeChange="0.1"                               VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"
                                Cursor="Hand"
                                Margin="10"/>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal">
                        <StackPanel
                            Grid.Column="1">
                            <Label
                                Content="Режим повтора"
                                Foreground="{StaticResource SecondaryText}"
                                HorizontalAlignment="Center"/>
                            <Grid>
                                <Slider 
                                    x:Name="TrackEndModeSlider"
                                    Style="{StaticResource TrackEndModeSliderStyle}"
                                    Minimum="0" Maximum="3" 
                                    TickFrequency="1" 
                                    IsSnapToTickEnabled="True"
                                    Value="0"
                                    Width="100" 
                                    HorizontalAlignment="Center"
                                    IsHitTestVisible="False"   
                                    Cursor="Hand"/>

                                <Button 
                                    x:Name="InvisibleSliderButton"
                                    Style="{StaticResource InvisibleButtonStyle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Width="100" Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="InvisibleSliderButton_Click"
                                    Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <Label 
                            x:Name="TrackEndModeLabel"
                            Foreground="{StaticResource SecondaryText}"
                            Width="75"
                            HorizontalAlignment="Center"
                            Margin="5"
                            VerticalAlignment="Center">
                            <Label.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                    TextWrapping="Wrap" 
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                </DataTemplate>
                            </Label.ContentTemplate>
                            <Label.Content>
                                Не повторять
                            </Label.Content>
                        </Label>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="SpeedButtonHalf"   Style="{StaticResource SpeedButtonStyle}" Content="0.5" Margin="3,0" Click="SpeedButton_Click"/>
                        <Button x:Name="SpeedButtonNormal" Style="{StaticResource SpeedButtonStyle}" Content="1"   Margin="3,0" Click="SpeedButton_Click"/>
                        <Button x:Name="SpeedButtonDouble" Style="{StaticResource SpeedButtonStyle}" Content="2"   Margin="3,0" Click="SpeedButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border 
            Grid.Row="1" 
            Grid.Column="0" 
            Style="{StaticResource GlassPanelStyle}">
            <Grid x:Name="FoldersAccessGrid">
                <TreeView 
                    x:Name="FoldersTreeView" 
                    SelectedItemChanged="FoldersTreeView_OnSelectedItemChanged"/>
            </Grid>
        </Border>
        
        <Border 
            Grid.Row="2" 
            Grid.Column="0" 
            Style="{StaticResource GlassPanelStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height = "Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel 
                    Grid.Row="0" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,5,0,10">
                    <Button 
                        x:Name="PlaylistAddButton" 
                        Margin="0,0,15,0" 
                        Click="PlaylistAddButton_Click"
                        Background="Transparent" 
                        BorderThickness="0"
                        Cursor="Hand">
                        <Image 
                            Source="/Image/add.png" 
                            Width="28" Height="28"/>
                    </Button>

                    <Button 
                        x:Name="PlaylistEditButton" 
                        Margin="2" 
                        Click="PlaylistEditButton_Click"
                        Background="Transparent" 
                        BorderThickness="0" 
                        Cursor="Hand">
                        <Image 
                            Source="/Image/edit.png" 
                            Width="28" Height="28"/>    
                    </Button>

                    <Button 
                    x:Name="PlaylistRemoveButton"
                    Margin="15,0,0,0" 
                    Click="PlaylistRemoveButton_Click"
                    Background="Transparent" 
                    BorderThickness="0"
                    Cursor="Hand">
                        <Image 
                            Source="/Image/remove.png"
                            Width="28" Height="28"/>
                    </Button>
                </StackPanel>
                <ListBox
                    Grid.Row="1">
                </ListBox>
            </Grid>
        </Border>

        <Border 
            Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Grid.ColumnSpan="2"
            Style="{StaticResource GlassPanelStyle}">
            <Grid x:Name="TrackListGrid">
                <Grid.OpacityMask>
                    <VisualBrush Stretch="Fill">
                        <VisualBrush.Visual>
                            <Border Background="White" 
                            CornerRadius="15" 
                            Width="{Binding ActualWidth, ElementName=TrackListGrid}" 
                            Height="{Binding ActualHeight, ElementName=TrackListGrid}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.OpacityMask>

                <DataGrid x:Name="TrackDataGrid"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  CanUserDeleteRows="False"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="TrackDataGrid_OnSelectionChanged"
                  ItemsSource="{Binding AudioFiles}"
                  Cursor="Hand"
                  Margin="0,0,0,15">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header=""  Binding="{Binding Index}" Width="Auto"/>
                        <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Исполнитель" Binding="{Binding Artist}" Width="*"/>
                        <DataGridTextColumn Header="Альбом" Binding="{Binding Album}" Width="*"/>
                        <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="Auto"/>
                        <DataGridTextColumn Header="" Width="Auto"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid 
                    x:Name="LoadingOverlay" 
                    Background="Transparent" 
                    Visibility="Collapsed">
                    <Image 
                        x:Name="LoadingGif"
                        Width="150" Height="150"
                        Stretch="Uniform"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter 
            Grid.Column="0" 
            Grid.Row="1"
            Width="7" 
            Background="Transparent"
            ResizeBehavior="BasedOnAlignment" 
            ResizeDirection="Columns"/>

        <GridSplitter 
            Grid.Column="0" 
            Grid.ColumnSpan="3" 
            Grid.Row="0"
            Height="7" Background="Transparent"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Bottom"
            ResizeBehavior="BasedOnAlignment" 
            ResizeDirection="Rows"/>

        <GridSplitter 
            Grid.Column="1" 
            Grid.Row="0"
            Width="7" 
            Background="Transparent"
            ResizeBehavior="BasedOnAlignment" 
            ResizeDirection="Columns"/>
    </Grid>
</Window>